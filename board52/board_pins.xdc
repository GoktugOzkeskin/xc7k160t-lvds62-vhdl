set_property PACKAGE_PIN AA10 [get_ports sys_clk156_clk_p]
set_property PACKAGE_PIN AB10 [get_ports sys_clk156_clk_n]
set_property IOSTANDARD LVDS [get_ports {sys_clk156_clk_p sys_clk156_clk_n}]
set_property PACKAGE_PIN U4 [get_ports reset]
set_property IOSTANDARD LVCMOS18 [get_ports reset]
create_clock -name ref156m25 -period 6.400 [get_ports sys_clk156_clk_p]
# 100ps is an analysis assumption, not a measured oscillator specification.
set_input_jitter [get_clocks ref156m25] 0.100
